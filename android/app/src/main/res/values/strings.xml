    <!-- Plurals e non semplici string: con un solo esercizio il testo fisso
         diceva "1 esercizi pronti ... verranno inseriti". La forma "one" vale
         solo per 1 in italiano; "other" copre anche lo zero ("0 esercizi
         pronti"), che è la forma corretta. -->
    <plurals name="genera_documento_riepilogo_conteggio">
        <item quantity="one">%1$d esercizio pronto su %2$d verrà inserito nel documento</item>
